# Copie para .env apenas se precisar mudar algum valor (o .env não é versionado).
# O docker compose lê o .env sozinho; o ./gradlew bootRun não: nesse caso exporte
# as mesmas variáveis no terminal antes de rodar a aplicação.
POSTGRES_DB=finapp
POSTGRES_USER=finapp
POSTGRES_PASSWORD=finapp

# Porta do PostgreSQL exposta na sua máquina (troque se a 5432 já estiver em uso)
DB_PORT=5432

# Porta da aplicação quando ela roda em container
APP_PORT=8080

# --- Versão publicada (perfil prod; não é usado no docker compose local) ---
# Conta de teste (HTTP Basic). Defina uma senha forte; nunca versione o .env.
FINAPP_ACESSO_TESTE_USUARIO=teste
FINAPP_ACESSO_TESTE_SENHA=troque-esta-senha
# Carrega dados de exemplo na primeira subida
FINAPP_SEED_DEMO=true
